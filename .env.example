# Copy to .env and edit:  cp .env.example .env
# .env is ignored by Git. Never commit it.

# Required. The PostgreSQL password, used by postgres and backend on the private network only.
# The offline installer generates a random one if you leave this placeholder in place.
POSTGRES_PASSWORD=change-me-local-only

# Image versions. Must match the images you built or loaded (the bundle manifest lists them).
APP_VERSION=1.0.0
OLLAMA_VERSION=0.40.3

# The local model, served by Ollama. It must already be installed in the model volume:
# ./scripts/pull-model.sh (connected) or ./scripts/offline-install.sh (from the bundle).
OLLAMA_MODEL=qwen3:0.6b

# Where the web UI listens. 127.0.0.1 = this machine only. On a server, set WEB_BIND=0.0.0.0
# (or a specific interface address) to serve your network, ideally behind a firewall.
WEB_BIND=127.0.0.1
WEB_PORT=3000

# Tuning
LOG_LEVEL=INFO
LLM_TIMEOUT_SECONDS=180
OLLAMA_MEMORY_LIMIT=3g
